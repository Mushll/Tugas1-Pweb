/* ============ HERO SECTION ============ */

.cvport-hero {
  display: flex;
  align-items: flex-start;
  gap: 2rem;
  padding: 2rem;
}

/* --- Foto profil (kiri) --- */
.cvport-photo-wrap {
  flex-shrink: 0;
  text-align: center;
}

.cvport-status {
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #888;
  margin-bottom: 0.5rem;
}

.cvport-photo-wrap img {
  display: block;
  border-radius: 4px;
}

/* --- Nama & deskripsi (kanan) --- */
.cvport-hero-main {
  flex: 1;
}

.cvport-hero-main h1 {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 2.5rem;
  line-height: 1.2;
  margin: 0 0 1rem 0;
}

.cvport-hero-main .desc {
  font-size: 1rem;
  line-height: 1.6;
  color: #333;
}

/* --- Foto dokumentasi kedua (mengambang di kanan teks deskripsi) --- */
.cvport-desc-photo {
  float: right;
  margin-left: 1em;
  margin-bottom: 1em;
  width: 175px;
  max-width: 45%;
  height: auto;
  border-radius: 8px;
}

/* ============ RESPONSIVE (MOBILE) ============ */

@media (max-width: 480px) {
  .cvport-hero {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cvport-desc-photo {
    float: none;
    display: block;
    margin: 0 auto 1em;
    width: 60%;
  }
}
```
